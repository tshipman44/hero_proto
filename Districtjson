{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
  "height": 74,
  "width": 210,
  "hideSelection": false,
  "fillHorizontally": true,
  "formatter": {
    "elmType": "div",
    "attributes": {
      "class": "sp-card-container"
    },
    "style": {
      "display": "flex",
      "align-items": "stretch",
      "width": "100%",
      "height": "100%",
      "padding": "3px",
      "box-sizing": "border-box"
    },
    "children": [
      {
        "elmType": "div",
        "attributes": {
          "title": "='Select ' + [$Title] + ' — ' + [$field_1]"
        },
        "style": {
          "display": "flex",
          "align-items": "center",
          "width": "100%",
          "height": "100%",
          "box-sizing": "border-box",
          "padding": "8px 28px 8px 8px",
          "border-radius": "12px 12px 12px 4px",
          "border": "=if(@isSelected, '2px solid #173d78', '1px solid #dce2e5')",
          "background-color": "=if(@isSelected, '#173d78', '#ffffff')",
          "box-shadow": "=if(@isSelected, '0 4px 12px rgba(23,61,120,0.20)', '0 2px 8px rgba(16,30,59,0.08)')",
          "cursor": "pointer",
          "overflow": "hidden"
        },
        "children": [
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "justify-content": "center",
              "width": "48px",
              "height": "48px",
              "min-width": "48px",
              "border-radius": "10px 10px 10px 3px",
              "background-color": "=if(@isSelected, '#ffffff', if([$field_4] == '', '#718796', [$field_4]))",
              "color": "=if(@isSelected, '#173d78', '#ffffff')",
              "margin-right": "10px"
            },
            "children": [
              {
                "elmType": "div",
                "style": {
                  "font-size": "7px",
                  "font-weight": "700",
                  "line-height": "1",
                  "letter-spacing": "0.7px",
                  "opacity": "0.85"
                },
                "txtContent": "DISTRICT"
              },
              {
                "elmType": "div",
                "style": {
                  "font-size": "22px",
                  "font-weight": "700",
                  "line-height": "1.05",
                  "margin-top": "2px"
                },
                "txtContent": "=replace([$field_1], 'District ', '')"
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "min-width": "0",
              "flex-grow": "1"
            },
            "children": [
              {
                "elmType": "div",
                "style": {
                  "font-size": "14px",
                  "font-weight": "700",
                  "line-height": "1.2",
                  "color": "=if(@isSelected, '#ffffff', '#101e3b')",
                  "white-space": "nowrap",
                  "overflow": "hidden",
                  "text-overflow": "ellipsis"
                },
                "txtContent": "[$Title]"
              },
              {
                "elmType": "div",
                "style": {
                  "font-size": "9px",
                  "line-height": "1.2",
                  "color": "=if(@isSelected, '#dce7f2', '#667287')",
                  "white-space": "nowrap",
                  "overflow": "hidden",
                  "text-overflow": "ellipsis",
                  "margin-top": "3px"
                },
                "txtContent": "[$field_2]"
              },
              {
                "elmType": "div",
                "style": {
                  "font-size": "8px",
                  "font-weight": "600",
                  "line-height": "1.2",
                  "color": "=if(@isSelected, '#ffffff', '#31586d')",
                  "margin-top": "3px"
                },
                "txtContent": "=[$field_3] + if([$field_3] == 1, ' guide', ' guides')"
              }
            ]
          }
        ]
      }
    ]
  }
}


With(
    {
        employeeEmail: Coalesce(
            ThisItem.Employee.Email,
            ThisItem.Email
        )
    },
    If(
        IsBlank(employeeEmail),
        SampleImage,
        IfError(
            Office365Users.UserPhotoV2(employeeEmail),
            IfError(
                ThisItem.Employee.Picture,
                SampleImage
            )
        )
    )
)
