GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash
MOCK_GEMINI=false

# Use a long, URL-safe value. The admin gallery lives at /admin/<ADMIN_URL_KEY>.
ADMIN_URL_KEY=replace-with-a-long-random-value

# Added automatically when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
